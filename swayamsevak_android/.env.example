# Set these values in Render's Environment settings. Do not commit real credentials.
DATABASE_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Used once to create the first database-backed admin account. Keep both secret.
ADMIN_USERNAME=your_admin_username
ADMIN_PIN=choose_a_strong_admin_pin
